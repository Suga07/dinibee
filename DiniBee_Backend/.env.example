# Copy only via scripts/init_env.py or scripts/init-env.ps1 to generate unique secrets.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/bookeat
DB_USERNAME=bookeat
DB_PASSWORD=GENERATE_WITH_SCRIPT
JWT_SECRET=GENERATE_WITH_SCRIPT
AUTH_TOKEN_PEPPER=GENERATE_WITH_SCRIPT
MAIL_ENCRYPTION_KEY=GENERATE_WITH_SCRIPT
JWT_ISSUER=bookeat-api
JWT_AUDIENCE=bookeat-clients
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@bookeat.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
APP_BIND_ADDRESS=127.0.0.1

SETTLEMENT_ENCRYPTION_KEY=GENERATE_WITH_SCRIPT
ONBOARDING_REQUIRED_DOCUMENTS=FSSAI,BUSINESS_REGISTRATION,OWNER_ID,PAN
DOCUMENT_STORAGE_PROVIDER=LOCAL
DOCUMENT_STORAGE_LOCAL_ROOT=./private-documents
DOCUMENT_STORAGE_S3_ENABLED=false
DOCUMENT_STORAGE_S3_BUCKET=
DOCUMENT_STORAGE_S3_REGION=ap-south-1

# Optional Phase 10 payment provider; never put secrets in frontend configuration.
ZOHO_PAYMENTS_ENABLED=false
ZOHO_PAYMENTS_SANDBOX=true
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_SIGNING_KEY=
ZOHO_PAYMENTS_WEBHOOK_SIGNING_KEY=
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_REFRESH_TOKEN=
ZOHO_PAYMENTS_REDIRECT_URI=
