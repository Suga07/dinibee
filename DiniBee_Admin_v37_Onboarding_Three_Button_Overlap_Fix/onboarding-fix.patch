+/** Map the flat Spring Detail DTO to the admin view. Never promote drafts. */
+export function normalizeRestaurantDetail(detail) {
+  if (!detail || typeof detail !== "object" || !detail.id) throw new Error("Restaurant detail response is missing");
+  return {
+    ...detail,
+    location: {
+      addressLine1: detail.addressLine1, addressLine2: detail.addressLine2,
+      city: detail.city, state: detail.state, postalCode: detail.postalCode, country: detail.country,
+    },
+    businessInfo: {
+      businessName: detail.onboardingForm?.businessName ?? detail.settlementProfile?.taxName,
+      businessRegistrationNumber: detail.businessRegistrationNumber,
+      gstNumber: detail.gstNumber, fssaiNumber: detail.fssaiNumber,
+    },
+    operatingHours: { hours: Array.isArray(detail.operatingHours) ? detail.operatingHours : [] },
+    requestedServices: (detail.services ?? []).filter(s => s.requested).map(s => s.serviceType),
+    documents: (detail.documents ?? []).map(d => ({ ...d, name: d.originalFilename, status: d.verificationStatus })),
+  };
+}
